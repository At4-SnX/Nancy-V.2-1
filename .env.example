# Ne mettez jamais de vrai token dans ce fichier. Placez les secrets dans .env ou dans les variables Railway.
DISCORD_TOKEN=
CLIENT_ID=
# Facultatif : laissez vide pour rendre les commandes slash disponibles sur tous les serveurs.
# Renseignez un serveur seulement si vous souhaitez tester les commandes immédiatement sur un serveur précis.
GUILD_ID=
PREFIX=&
LOG_CHANNEL_ID=
# Chemin de la base SQLite. Sur Railway avec un volume, utilisez /app/data/levels.sqlite.
SQLITE_PATH=/app/data/levels.sqlite
# Ton identifiant Discord personnel. Seul ce compte peut désactiver antibot ou antinuke.
BOT_OWNER_ID=

# Catégorie Discord des tickets : utilisez une catégorie commune, ou les variables par type ci-dessous.
TICKET_CATEGORY_ID=
TICKET_CATEGORY_FONDATION_ID=
TICKET_CATEGORY_LEGAL_ID=
TICKET_CATEGORY_ILLEGAL_ID=
TICKET_CATEGORY_REPORT_STAFF_ID=
TICKET_CATEGORY_REPORT_JOUEUR_ID=
TICKET_CATEGORY_QUESTION_ID=
TICKET_CATEGORY_UNBAN_ID=
TICKET_CATEGORY_BUILD_ID=
